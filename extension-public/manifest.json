{
    "manifest_version": 3,
    "name": "랭크프리 — 네이버 쇼핑·플레이스 분석",
    "version": "0.4.0",
    "description": "네이버 마케팅을 위한 무료 분석 도구 — 쇼핑·플레이스·키워드·블로그·상품 리뷰를 한 곳에서 분석. 사장님·마케터·셀러가 내 순위와 시장을 빠르게 파악하도록 돕습니다. rankfree.kr 무료 로그인.",
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "permissions": [
        "storage",
        "tabs"
    ],
    "host_permissions": [
        "https://rankfree.kr/*",
        "https://*.rankfree.co.kr/*",
        "https://search.shopping.naver.com/*",
        "https://search.naver.com/*",
        "https://smartstore.naver.com/*",
        "https://brand.naver.com/*",
        "https://map.naver.com/*",
        "https://pcmap.place.naver.com/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://search.shopping.naver.com/search/*"
            ],
            "js": [
                "content/injected.js"
            ],
            "world": "MAIN",
            "run_at": "document_start"
        },
        {
            "matches": [
                "https://search.shopping.naver.com/search/*"
            ],
            "js": [
                "content/content.js",
                "content/shop-seo.js"
            ],
            "css": [
                "content/panel.css",
                "content/seller-power.css",
                "content/shop-seo.css"
            ],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "https://search.naver.com/search.naver*"
            ],
            "js": [
                "content/content.js"
            ],
            "css": [
                "content/panel.css",
                "content/seller-power.css"
            ],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "https://map.naver.com/*"
            ],
            "js": [
                "content/content.js"
            ],
            "css": [
                "content/panel.css",
                "content/seller-power.css"
            ],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "https://smartstore.naver.com/*/products/*",
                "https://brand.naver.com/*/products/*"
            ],
            "js": [
                "content/injected-store.js"
            ],
            "world": "MAIN",
            "run_at": "document_start"
        },
        {
            "matches": [
                "https://smartstore.naver.com/*/products/*",
                "https://brand.naver.com/*/products/*"
            ],
            "js": [
                "content/product.js"
            ],
            "css": [
                "content/panel.css",
                "content/seller-power.css"
            ],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "https://pcmap.place.naver.com/*"
            ],
            "all_frames": true,
            "js": [
                "content/place-rank.js"
            ],
            "css": [
                "content/place-rank.css"
            ],
            "run_at": "document_idle"
        }
    ],
    "action": {
        "default_title": "RankFree 분석",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    }
}
